# FindMed Backend - Environment Variables

# === Server Configuration ===
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# === Database ===
MONGODB_URI=mongodb://localhost:27017/findmed
# For multiple MongoDB connections, use comma-separated URIs:
# MONGODB_URIS=mongodb://localhost:27017/findmed,mongodb://backup-host:27017/findmed-backup

# === Frontend Configuration ===
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_FRONTEND_URL=https://admin-findmed.onrender.com

# === API Service Configuration (Modern Patterns) ===
# Timeout for external API calls (milliseconds)
API_TIMEOUT=10000

# Maximum retry attempts for failed API calls
API_MAX_RETRIES=3

# Initial delay for retry backoff (milliseconds)
# Uses exponential backoff: 1s, 2s, 4s, 8s...
API_RETRY_DELAY_MS=1000

# Enable detailed API request/response logging
ENABLE_API_LOGGING=false

# Logging level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# === Authentication & Security ===
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# === Firebase Cloud Messaging (FCM) ===
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === Bot API (Custom Service) ===
BOT_API_URL=http://localhost:5000
BOT_API_KEY=your-bot-api-key

# === File Upload (Cloudinary) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# === Email Configuration (Optional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@findmed.com

# === Admin Configuration ===
ADMIN_SECRET_KEY=your-admin-secret

# === HTTPS Configuration (Optional) ===
# HTTPS_KEY_PATH=/path/to/key.pem
# HTTPS_CERT_PATH=/path/to/cert.pem

# === Feature Flags ===
ENABLE_AD_GENERATOR=true
AD_GENERATOR_INTERVAL_MIN=15

# === Monitoring & Alerts ===
# Webhook URL for error alerts
ALERT_WEBHOOK=https://your-webhook-url/alerts

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
