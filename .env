# comma-separated list of MongoDB connection URIs; will open one connection per entry.
# When this variable is defined it overrides MONGODB_URI/MONGO_URI.
# Replace the placeholders with your actual URIs.
MONGODB_URIS=mongodb+srv://kalekale1276_db_user:ZmjQacVqq22hi99s@cluster0.mubm6nl.mongodb.net/findmed

# optional labels to describe each URI. labels are displayed during startup
# when the connections succeed. Example:
# MONGODB_DB_LABELS=admin,users,chat

# if you still wish to support the older single‑URI variable you can leave it as
# a fallback (not strictly necessary once MONGODB_URIS is set).
# MONGODB_URI=mongodb://localhost:27017/findmed

JWT_SECRET=your_super_secret_jwt_key_here_make_it_strong

ENABLE_AD_GENERATOR=false
